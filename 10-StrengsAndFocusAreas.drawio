        <mxCell id="s1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#F0F8F1;strokeColor=#A6C9AC;fontSize=16;align=left;spacingLeft=65;spacingRight=16;" value="&lt;b&gt;Regional independence&lt;/b&gt;&lt;br&gt;Shared services and customer workloads scale and operate regionally." vertex="1">
          <mxGeometry height="104" width="760" x="30" y="308" as="geometry" />
        </mxCell>
        <mxCell id="si1" parent="1" style="html=1;whiteSpace=wrap;ellipse;fillColor=#D4EBDD;strokeColor=none;fontColor=#28734B;fontSize=23;fontStyle=1;" value="✓" vertex="1">
