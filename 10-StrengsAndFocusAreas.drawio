        <mxCell id="s4" parent="1" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#F0F8F1;strokeColor=#A6C9AC;fontSize=16;align=left;spacingLeft=65;spacingRight=16;" value="&lt;b&gt;Declarative recovery&lt;/b&gt;&lt;br&gt;Regional operators reconstruct workloads from desired state." vertex="1">
