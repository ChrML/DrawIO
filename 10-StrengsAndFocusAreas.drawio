        <mxCell id="s5" parent="1" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#F0F8F1;strokeColor=#A6C9AC;fontSize=16;align=left;spacingLeft=65;spacingRight=16;" value="&lt;b&gt;Cost-efficient scaling&lt;/b&gt;&lt;br&gt;Multi-tenancy, lightweight workloads, bounded database cache and long-term object storage." vertex="1">
          <mxGeometry height="104" width="760" x="30" y="780" as="geometry" />
        </mxCell>
        <mxCell id="si5" parent="1" style="html=1;whiteSpace=wrap;ellipse;fillColor=#D4EBDD;strokeColor=none;fontColor=#28734B;fontSize=23;fontStyle=1;" value="✓" vertex="1">
          <mxGeometry height="34" width="34" x="45" y="815" as="geometry" />
        </mxCell>
        <mxCell id="r0" parent="1" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#F4F7FB;strokeColor=#A8BCD5;fontSize=15;align=left;spacingLeft=20;spacingRight=20;" value="&lt;b&gt;Privileged services &amp; blast radius&lt;/b&gt;&lt;br&gt;SSO, Rancher, Site Operators and release management have wider privileges.&lt;br&gt;&lt;b&gt;Focus:&lt;/b&gt; Enforce least privilege, scoped APIs, independent credentials and deployment restrictions; review cross-boundary trust." vertex="1">
          <mxGeometry height="128" width="650" x="820" y="190" as="geometry" />
        </mxCell>
        <mxCell id="r1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#F4F7FB;strokeColor=#A8BCD5;fontSize=15;align=left;spacingLeft=20;spacingRight=20;" value="&lt;b&gt;Single-region global services&lt;/b&gt;&lt;br&gt;SSO and Global Site Operator.&lt;br&gt;&lt;b&gt;Focus:&lt;/b&gt; Validate tokens locally, cache routes, test recovery and expand geographically when justified." vertex="1">
          <mxGeometry height="128" width="650" x="820" y="332" as="geometry" />
        </mxCell>
        <mxCell id="r2" parent="1" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#F4F7FB;strokeColor=#A8BCD5;fontSize=15;align=left;spacingLeft=20;spacingRight=20;" value="&lt;b&gt;Storage availability&lt;/b&gt;&lt;br&gt;Critical dependency for customer workloads.&lt;br&gt;&lt;b&gt;Focus:&lt;/b&gt; Test durable writes, replication, complete storage recovery and recovery targets." vertex="1">
          <mxGeometry height="128" width="650" x="820" y="474" as="geometry" />
        </mxCell>
        <mxCell id="r3" parent="1" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#F4F7FB;strokeColor=#A8BCD5;fontSize=15;align=left;spacingLeft=20;spacingRight=20;" value="&lt;b&gt;Safe workload relocation&lt;/b&gt;&lt;br&gt;Avoid overlapping active instances.&lt;br&gt;&lt;b&gt;Focus:&lt;/b&gt; Controlled relocation initially; enforce exclusive ownership before automation." vertex="1">
          <mxGeometry height="128" width="650" x="820" y="616" as="geometry" />
        </mxCell>
        <mxCell id="r4" parent="1" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#F4F7FB;strokeColor=#A8BCD5;fontSize=15;align=left;spacingLeft=20;spacingRight=20;" value="&lt;b&gt;Operational scalability&lt;/b&gt;&lt;br&gt;Multiple clusters and subscriptions.&lt;br&gt;&lt;b&gt;Focus:&lt;/b&gt; Standardize deployments, automate maintenance and centralize health monitoring." vertex="1">
          <mxGeometry height="128" width="650" x="820" y="758" as="geometry" />
        </mxCell>
        <mxCell id="bottom" parent="1" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#EEF2F6;strokeColor=#AAB7C5;fontSize=17;align=left;spacingLeft=20;" value="&lt;b&gt;Guiding principle:&lt;/b&gt; A compromise of one workload, customer or region must not automatically compromise others. Validate trust boundaries and recovery behaviour, automate operations and introduce redundancy incrementally." vertex="1">
          <mxGeometry height="75" width="1440" x="30" y="915" as="geometry" />
        </mxCell>
